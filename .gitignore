# TLS 证书的本地物化目录（含客户端私钥；权限 0700/0600）。
# 库里才是正本，这里只是给驱动用的一份本地缓存，绝不入库到 git。
certs/
__pycache__/
.venv_fi/
.DS_Store
# 判据生成的自签证书（含私钥），仅本地联调用
test_scripts/ssl/out/

# ---- 前端构建 ----
node_modules/
# 构建产物：由 npm run build 生成，不入库（源文件才是正本）
static/js/
# static/vendor/ **要入库**：落本地第三方库的意义就是部署时不依赖外网与 npm，
# 不入库就等于把 CDN 依赖换成了 npm 依赖，白做。
